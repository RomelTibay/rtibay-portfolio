---
const facts = [
  { k: "Role", v: "Network Admin & Software Developer" },
  { k: "Location", v: "Laguna, Philippines" },
  { k: "Education", v: "BSIT Senior · Mapúa MCL" },
  { k: "Focus", v: "Networks · Full-stack · Cross-platform" },
];

const dossier = [
  { k: "name", v: "Romel Andres S. Tibay" },
  { k: "alias", v: "rtibay_r" },
  { k: "role", v: "Net Admin / Dev" },
  { k: "clearance", v: "LVL-03" },
  { k: "location", v: "Laguna, PH" },
];
---

<section id="about" class="border-b-2 border-line">
  <div class="mx-auto max-w-7xl px-6 md:px-10 py-16 md:py-24">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-5">
      <div class="reveal md:col-span-2">
        <p
          class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-muted"
        >
          <span class="inline-block h-2.5 w-2.5 bg-signal"></span>
          Who I am
        </p>
        <h2
          class="font-sans text-4xl font-bold uppercase leading-none tracking-tight text-chalk md:text-6xl"
        >
          About
        </h2>

        <div class="reveal mt-8 hud-corners max-w-xs border-2 border-line bg-paper">
          <div
            class="hatch flex items-center justify-between border-b-2 border-line px-3 py-2"
          >
            <span
              class="hud-tab bg-chalk font-mono text-[0.65rem] font-bold uppercase tracking-[0.2em] text-void"
            >
              <span>ctOS // Dossier</span>
            </span>
            <span class="font-mono text-[0.65rem] text-muted">◈</span>
          </div>
          <dl class="divide-y-2 divide-line font-mono text-xs sm:text-sm">
            {
              dossier.map((row) => (
                <div class="flex items-baseline justify-between gap-3 px-4 py-2.5">
                  <dt class="text-muted">{row.k}</dt>
                  <dd class="text-right font-semibold">{row.v}</dd>
                </div>
              ))
            }
            <div class="flex items-center justify-between gap-3 px-4 py-2.5">
              <dt class="text-muted">status</dt>
              <dd class="flex items-center gap-1.5 text-right font-semibold text-signal">
                <span class="pulse inline-block h-1.5 w-1.5 rounded-full bg-signal"></span>
                Active
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="reveal md:col-span-3">
        <p class="text-lg leading-relaxed md:text-xl">
          I'm <span class="bg-accent px-1 font-semibold text-void shadow-glow">Romel Andres S. Tibay</span>,
          a BSIT senior at Mapúa Malayan Colleges Laguna, based in Laguna,
          Philippines. I work where <span class="font-semibold">network administration</span>
          meets <span class="font-semibold">software development</span> —
          configuring networks in Cisco Packet Tracer and Linux, and shipping
          full-stack web and cross-platform apps with Node.js, Flutter and
          Supabase. I care about systems that are reliable end to end, from the
          wire up to the interface.
        </p>
      </div>
    </div>

    <dl
      data-stagger
      class="mt-12 grid grid-cols-1 gap-[2px] border-2 border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        facts.map((fact) => (
          <div class="reveal bg-paper p-5 transition-colors hover:bg-line/30">
            <dt class="font-mono text-xs uppercase tracking-[0.15em] text-accent">
              &gt; {fact.k}
            </dt>
            <dd class="mt-2 font-semibold leading-snug">{fact.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
