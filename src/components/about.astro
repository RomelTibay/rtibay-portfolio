---
const facts = [
  { k: "Role", v: "Network Admin & Software Developer" },
  { k: "Location", v: "Laguna, Philippines" },
  { k: "Education", v: "BSIT Senior · Mapúa MCL" },
  { k: "Focus", v: "Networks · Full-stack · Cross-platform" },
];
---

<section id="about" class="border-b-2 border-line">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-5">
      <div class="reveal md:col-span-2">
        <p
          class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-muted"
        >
          <span class="inline-block h-2.5 w-2.5 bg-signal"></span>
          Who I am
        </p>
        <h2
          class="font-sans text-4xl font-bold uppercase leading-none tracking-tight md:text-6xl"
        >
          About
        </h2>
      </div>

      <div class="reveal md:col-span-3">
        <p class="text-lg leading-relaxed md:text-xl">
          I'm <span class="bg-lime px-1 font-semibold text-void shadow-glow-lime">Romel Andres S. Tibay</span>,
          a BSIT senior at Mapúa Malayan Colleges Laguna, based in Laguna,
          Philippines. I work where <span class="font-semibold">network administration</span>
          meets <span class="font-semibold">software development</span> —
          configuring networks in Cisco Packet Tracer and Linux, and shipping
          full-stack web and cross-platform apps with Node.js, Flutter and
          Supabase. I care about systems that are reliable end to end, from the
          wire up to the interface.
        </p>
      </div>
    </div>

    <dl
      data-stagger
      class="mt-12 grid grid-cols-1 gap-[2px] border-2 border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        facts.map((fact) => (
          <div class="reveal bg-paper p-5">
            <dt class="font-mono text-xs uppercase tracking-[0.15em] text-signal">
              {fact.k}
            </dt>
            <dd class="mt-2 font-semibold leading-snug">{fact.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
