---
// TODO: Create a free form at https://formspree.io and replace
// YOUR_FORMSPREE_ID with your own form ID. Until then, submissions
// won't send — the direct email link on the left always works.
const FORMSPREE_ENDPOINT = "https://formspree.io/f/YOUR_FORMSPREE_ID";
const EMAIL = "romel.tibay1234@gmail.com";
const MAILTO = `https://mail.google.com/mail/?view=cm&fs=1&to=${EMAIL}&su=Hey%20Romel!`;
---

<section id="contact" class="border-b-2 border-line">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24">
    <div class="reveal mb-12">
      <p
        class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-muted"
      >
        <span class="inline-block h-2.5 w-2.5 bg-signal"></span>
        Let's Talk
      </p>
      <h2
        class="font-sans text-4xl font-bold uppercase leading-none tracking-tight md:text-6xl"
      >
        Contact
      </h2>
    </div>

    <div data-stagger class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <!-- Left: direct contact (always works, no JS needed) -->
      <div class="reveal flex flex-col gap-4">
        <p class="text-lg leading-relaxed">
          Have a question or a project in mind? Reach out — the fastest way is a
          direct email.
        </p>

        <a
          href={MAILTO}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between gap-3 border-2 border-accent bg-accent px-5 py-4 text-void shadow-glow transition-all hover:-translate-y-0.5 hover:border-signal hover:bg-signal hover:shadow-glow-signal active:translate-y-0"
        >
          <span class="min-w-0">
            <span class="block font-mono text-xs uppercase tracking-wide text-void/70">
              Email
            </span>
            <span class="block truncate font-mono text-sm font-bold">{EMAIL}</span>
          </span>
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0">
            <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path>
          </svg>
        </a>

        <div
          class="grid grid-cols-1 gap-[2px] border-2 border-line bg-line sm:grid-cols-2"
        >
          <div class="bg-paper p-4">
            <p class="font-mono text-xs uppercase tracking-[0.15em] text-signal">
              Location
            </p>
            <p class="mt-1 font-semibold">Laguna, Philippines</p>
          </div>
          <a
            href="https://github.com/RomelTibay"
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-paper p-4 transition-colors hover:bg-lime"
          >
            <p class="font-mono text-xs uppercase tracking-[0.15em] text-signal group-hover:text-void">
              GitHub
            </p>
            <p class="mt-1 font-semibold group-hover:text-void">@RomelTibay</p>
          </a>
        </div>
      </div>

      <!-- Right: message form -->
      <div class="reveal border-2 border-line bg-paper p-6 shadow-hard">
        <form id="contact-form" action={FORMSPREE_ENDPOINT} method="POST" class="flex flex-col gap-4">
          <label class="font-mono text-xs uppercase tracking-wide text-muted">
            Name
            <input
              type="text"
              name="from_name"
              required
              class="mt-1.5 w-full border-2 border-line bg-paper px-4 py-2.5 font-sans text-base text-ink outline-none focus:bg-lime/20 focus:ring-0"
            />
          </label>
          <label class="font-mono text-xs uppercase tracking-wide text-muted">
            Email
            <input
              type="email"
              name="reply_to"
              required
              class="mt-1.5 w-full border-2 border-line bg-paper px-4 py-2.5 font-sans text-base text-ink outline-none focus:bg-lime/20 focus:ring-0"
            />
          </label>
          <label class="font-mono text-xs uppercase tracking-wide text-muted">
            Message
            <textarea
              name="message"
              rows="5"
              required
              class="mt-1.5 w-full resize-none border-2 border-line bg-paper px-4 py-2.5 font-sans text-base text-ink outline-none focus:bg-lime/20 focus:ring-0"
            ></textarea>
          </label>
          <button
            type="submit"
            class="mt-1 border-2 border-accent bg-accent px-5 py-3 font-mono text-sm font-bold uppercase tracking-wide text-void shadow-glow transition-all hover:-translate-y-0.5 hover:border-signal hover:bg-signal hover:shadow-glow-signal active:translate-y-0"
          >
            Send Message
          </button>
        </form>
        <div
          id="form-message"
          class="mt-4 hidden border-2 border-lime bg-lime px-4 py-3 font-mono text-sm font-bold uppercase text-void"
        >
          ✅ Thanks — message sent.
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });
      if (response.ok) {
        form.reset();
        form.style.display = "none";
        formMessage.classList.remove("hidden");
      } else {
        const data = await response.json().catch(() => ({}));
        console.error("Error response:", data);
        alert(
          "Couldn't send via the form. Please email romel.tibay1234@gmail.com directly."
        );
      }
    } catch (error) {
      console.error("Error:", error);
      alert(
        "Couldn't send via the form. Please email romel.tibay1234@gmail.com directly."
      );
    }
  });
</script>
