---
// Original "network target" emblem — concentric rings, tick marks, crosshair,
// and an abstract angular signal glyph. Decorative only. Colour follows
// currentColor so it renders white on dark and black on the inverted band.
interface Props {
  class?: string;
  sweep?: boolean;
}
const { class: klass = "", sweep = false } = Astro.props;

// 24 radial tick marks around the outer ring.
const ticks = Array.from({ length: 24 }, (_, i) => i * 15);
---

<svg
  class={klass}
  viewBox="0 0 200 200"
  fill="none"
  stroke="currentColor"
  aria-hidden="true"
>
  <!-- concentric rings -->
  <circle cx="100" cy="100" r="94" stroke-width="1" opacity="0.35" />
  <circle cx="100" cy="100" r="74" stroke-width="1.2" opacity="0.55" />
  <circle cx="100" cy="100" r="52" stroke-width="1" opacity="0.4" />
  <circle cx="100" cy="100" r="30" stroke-width="1.4" opacity="0.7" />

  <!-- radial tick marks -->
  <g opacity="0.5">
    {
      ticks.map((deg) => (
        <line
          x1="100"
          y1="8"
          x2="100"
          y2={deg % 45 === 0 ? 20 : 14}
          stroke-width={deg % 45 === 0 ? 1.6 : 0.8}
          transform={`rotate(${deg} 100 100)`}
        />
      ))
    }
  </g>

  <!-- faint crosshair -->
  <line x1="100" y1="14" x2="100" y2="186" stroke-width="0.6" opacity="0.25" />
  <line x1="14" y1="100" x2="186" y2="100" stroke-width="0.6" opacity="0.25" />

  {
    sweep && (
      <g class="radar-sweep" opacity="0.5">
        <path d="M100 100 L100 6 A94 94 0 0 1 168 34 Z" fill="currentColor" opacity="0.12" stroke="none" />
        <line x1="100" y1="100" x2="100" y2="6" stroke-width="1.4" />
      </g>
    )
  }

  <!-- central angular signal glyph (original mark) -->
  <g stroke-width="2.4" stroke-linecap="square" stroke-linejoin="miter">
    <rect x="82" y="82" width="36" height="36" transform="rotate(45 100 100)" stroke-width="1.6" opacity="0.85" />
    <path d="M84 108 L94 92 L100 104 L106 92 L116 108" opacity="0.95" />
  </g>
  <circle cx="100" cy="100" r="3.4" fill="currentColor" stroke="none" />
</svg>
