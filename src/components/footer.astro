---
const currentYear = new Date().getFullYear();

const socials = [
  {
    href: "https://github.com/RomelTibay",
    label: "GitHub",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/></svg>',
  },
  {
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=romel.tibay1234@gmail.com&su=Hey%20Romel!",
    label: "Email",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/></svg>',
  },
];

const builtWith = [
  { desc: "Built with", name: "Astro", icon: "/svg/astro.svg" },
  { desc: "Styled with", name: "TailwindCSS", icon: "/svg/tailwindcss.svg" },
  { desc: "Deployed on", name: "Vercel", icon: "/svg/vercel.svg" },
];
---

<footer class="border-t-2 border-line bg-paper text-ink">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-16">
    <div data-stagger class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <div class="reveal">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-signal glow-s">
          Romel Andres S. Tibay
        </p>
        <p
          class="mt-3 font-sans text-3xl font-bold uppercase leading-none tracking-tight md:text-5xl"
        >
          Let's build<br />something.
        </p>
        <div class="mt-6 flex gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="grid h-11 w-11 place-items-center border-2 border-line bg-paper transition-all hover:border-accent hover:bg-accent hover:text-void hover:shadow-glow"
              >
                <Fragment set:html={s.icon} />
              </a>
            ))
          }
        </div>
      </div>

      <div class="reveal md:justify-self-end">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-ink/50">
          Colophon
        </p>
        <ul class="space-y-3">
          {
            builtWith.map((tech) => (
              <li class="flex items-center gap-3 font-mono text-sm">
                <span class="text-ink/50">{tech.desc}</span>
                <img
                  src={tech.icon}
                  alt={tech.name}
                  class="h-5 w-5 object-contain brightness-0 invert"
                  loading="lazy"
                />
                <span class="font-bold">{tech.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Game-HUD readout (flavor) -->
    <div
      class="mt-12 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[0.65rem] uppercase tracking-wider text-muted"
    >
      <span class="text-lime">● rec</span>
      <span>player: romel_tibay</span>
      <span>build v1.0</span>
      <span>60 fps</span>
      <span>⌂ Laguna, PH</span>
      <span class="text-accent">cheat: ↑↑↓↓←→←→ b a</span>
    </div>

    <div
      class="mt-6 flex flex-col gap-2 border-t-2 border-line/20 pt-6 font-mono text-xs text-ink/60 sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {currentYear} Romel Andres S. Tibay. All rights reserved.</span>
    </div>
  </div>
</footer>
