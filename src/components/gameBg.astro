---
// ctOS network-mesh backdrop. Decorative only — a faint triangulated grid of
// nodes and links, a few pulsing hubs, and a couple of travelling data packets.
function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20240718);

const W = 1440;
const H = 900;
const COLS = 9;
const ROWS = 6;
const cw = W / (COLS - 1);
const ch = H / (ROWS - 1);

// Jittered grid of points.
const grid: { x: number; y: number }[][] = [];
for (let j = 0; j < ROWS; j++) {
  const row: { x: number; y: number }[] = [];
  for (let i = 0; i < COLS; i++) {
    const jx = (rand() - 0.5) * cw * 0.7;
    const jy = (rand() - 0.5) * ch * 0.7;
    row.push({
      x: +(i * cw + jx).toFixed(1),
      y: +(j * ch + jy).toFixed(1),
    });
  }
  grid.push(row);
}

// Triangulated edges: right, down, and one diagonal per cell.
const edges: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let j = 0; j < ROWS; j++) {
  for (let i = 0; i < COLS; i++) {
    const a = grid[j][i];
    if (i + 1 < COLS) edges.push({ x1: a.x, y1: a.y, x2: grid[j][i + 1].x, y2: grid[j][i + 1].y });
    if (j + 1 < ROWS) edges.push({ x1: a.x, y1: a.y, x2: grid[j + 1][i].x, y2: grid[j + 1][i].y });
    if (i + 1 < COLS && j + 1 < ROWS)
      edges.push({ x1: a.x, y1: a.y, x2: grid[j + 1][i + 1].x, y2: grid[j + 1][i + 1].y });
  }
}

const nodes = grid.flat();

// A few data packets travelling along selected links.
const packetEdges = [edges[8], edges[26], edges[44]].filter(Boolean);
const packets = packetEdges.map((e, k) => ({
  x: e.x1,
  y: e.y1,
  dx: +(e.x2 - e.x1).toFixed(1),
  dy: +(e.y2 - e.y1).toFixed(1),
  dur: 5 + k * 1.7,
  delay: k * 1.3,
}));
---

<div class="game-bg" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <g class="mesh-lines">
      {edges.map((e) => <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} />)}
    </g>
    <g class="mesh-nodes">
      {
        nodes.map((n, idx) =>
          idx % 6 === 0 ? (
            <circle
              cx={n.x}
              cy={n.y}
              r="2.4"
              class="pnode"
              style={`animation-delay:${((idx % 5) * 0.6).toFixed(1)}s`}
            />
          ) : (
            <circle cx={n.x} cy={n.y} r="1.4" />
          )
        )
      }
    </g>
    <g class="mesh-packets">
      {
        packets.map((p) => (
          <circle
            cx={p.x}
            cy={p.y}
            r="2.6"
            class="packet"
            style={`--dx:${p.dx}px;--dy:${p.dy}px;--pdur:${p.dur}s;--pdelay:${p.delay}s`}
          />
        ))
      }
    </g>
  </svg>
</div>

<style>
  .game-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .game-bg svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .mesh-lines line {
    stroke: var(--accent);
    stroke-width: 0.6;
    opacity: 0.1;
  }
  .mesh-nodes circle {
    fill: var(--accent);
    opacity: 0.26;
  }
  .pnode {
    opacity: 0.5;
    animation: node-pulse 3.4s ease-in-out infinite;
  }
  @keyframes node-pulse {
    0%,
    100% {
      opacity: 0.25;
      r: 2;
    }
    50% {
      opacity: 0.85;
      r: 3.4;
    }
  }
  .packet {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px var(--accent));
    animation: packet-move var(--pdur, 6s) linear infinite var(--pdelay, 0s);
  }
  @keyframes packet-move {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      transform: translate(var(--dx), var(--dy));
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pnode,
    .packet {
      animation: none;
    }
    .packet {
      opacity: 0;
    }
  }
</style>
