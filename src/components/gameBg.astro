---
// Minimal neon gaming-icon backdrop. Decorative only.
const P = {
  gamepad:
    "M6 11h4m-2-2v4M15 12h.01M18 10h.01M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.07-1.07A2 2 0 0 1 11.485 16h1.03a2 2 0 0 1 1.415.586L15 17.6c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.544-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5Z",
  heart:
    "M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z",
  star:
    "M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 16.9l-5.8 3.05 1.11-6.46-4.7-4.58 6.49-.94z",
  arrow: "M12 19V5M5 12l7-7 7 7",
  invader:
    "M7 4v3H4v3H2v5h3v-2h2v2h10v-2h2v2h3v-5h-2V7h-3V4h-3v3H10V4z M8 11h2v2H8zM14 11h2v2h-2z",
};

const icons = [
  { p: P.gamepad, top: "13%", left: "5%", s: 56, c: "var(--accent)", o: 0.22, d: "7s", delay: "0s" },
  { p: P.heart, top: "26%", left: "89%", s: 34, c: "var(--signal)", o: 0.16, d: "6s", delay: "1.2s" },
  { p: P.invader, top: "60%", left: "91%", s: 40, c: "var(--purple)", o: 0.18, d: "8s", delay: "0.4s" },
  { p: P.star, top: "70%", left: "7%", s: 30, c: "var(--lime)", o: 0.16, d: "5.5s", delay: "0.8s" },
  { p: P.arrow, top: "44%", left: "83%", s: 28, c: "var(--accent)", o: 0.14, d: "6.5s", delay: "2s" },
  { p: P.gamepad, top: "86%", left: "74%", s: 34, c: "var(--purple)", o: 0.14, d: "7.5s", delay: "1.6s" },
  { p: P.star, top: "90%", left: "34%", s: 22, c: "var(--signal)", o: 0.13, d: "6s", delay: "0.2s" },
];
---

<div class="game-bg" aria-hidden="true">
  {
    icons.map((i) => (
      <span
        class="gicon"
        style={`top:${i.top};left:${i.left};width:${i.s}px;height:${i.s}px;color:${i.c};opacity:${i.o};--dur:${i.d};animation-delay:${i.delay}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d={i.p} />
        </svg>
      </span>
    ))
  }
</div>

<style>
  .game-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .gicon {
    position: absolute;
    display: block;
    filter: drop-shadow(0 0 8px currentColor);
    animation: float-y var(--dur, 7s) ease-in-out infinite;
  }
  .gicon svg {
    width: 100%;
    height: 100%;
  }
  @keyframes float-y {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-16px) rotate(3deg);
    }
  }
</style>
