---
import DataStream from "../components/dataStream.astro";
import CtosEmblem from "../components/ctosEmblem.astro";

// Fake ctOS system-readout bars (decorative HUD flavor).
const readouts = [
  { k: "CPU", v: 34, live: true },
  { k: "MEM", v: 61, live: false },
  { k: "NET", v: 78, live: true },
];
---

<section id="home" class="relative overflow-hidden border-b-2 border-line">
  <!-- faint concentric-ring radar behind the hero (reference centerpiece) -->
  <CtosEmblem
    class="pointer-events-none absolute -top-24 left-1/2 h-[40rem] w-[40rem] -translate-x-1/2 text-ink opacity-[0.05] md:left-[62%]"
  />
  <div class="relative mx-auto max-w-7xl px-6 md:px-10">
    <div
      class="grid grid-cols-1 items-center gap-10 py-16 md:grid-cols-5 md:py-24"
    >
      <!-- Left: headline -->
      <div class="hero-anim md:col-span-3">
        <p
          class="mb-6 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-muted md:text-sm"
        >
          <span class="pulse inline-block h-2.5 w-2.5 bg-signal"></span>
          &gt; ctOS // Network Admin · Software Dev<span class="cursor ml-0.5 text-accent">_</span>
        </p>

        <h1
          class="neon-title glitch font-sans text-6xl font-bold uppercase leading-[0.85] tracking-tighter sm:text-7xl md:text-8xl"
        >
          Romel<br />Andres<br />Tibay<span class="text-signal glow-s">.</span>
        </h1>

        <p
          class="mt-6 max-w-xl font-mono text-sm leading-relaxed text-ink/80 md:text-base"
        >
          Aspiring <span class="bg-accent px-1 font-semibold text-void shadow-glow">network administrator</span>
          &amp; software developer. A BSIT senior at Mapúa MCL exploring network
          administration and web development.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 border-2 border-chalk bg-chalk px-5 py-2.5 font-mono text-sm font-bold uppercase tracking-wide text-void shadow-glow-white transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:shadow-glow active:translate-y-0"
          >
            View Work
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
              <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path>
            </svg>
          </a>
          <a
            href="/resume.pdf"
            download
            class="inline-flex items-center gap-2 border-2 border-line bg-paper px-5 py-2.5 font-mono text-sm font-bold uppercase tracking-wide text-ink shadow-hard-sm transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent active:translate-y-0 active:shadow-none"
          >
            Resume
          </a>
          <a
            href="#contact"
            class="font-mono text-sm font-bold uppercase tracking-wide underline decoration-2 underline-offset-4 hover:text-accent"
          >
            Get in touch
          </a>
        </div>

        <div class="mt-6 flex items-center gap-3">
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://github.com/RomelTibay"
            aria-label="GitHub"
            class="grid h-11 w-11 place-items-center border-2 border-line bg-paper transition-all hover:border-accent hover:bg-accent hover:text-void hover:shadow-glow"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
              <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path>
            </svg>
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://mail.google.com/mail/?view=cm&fs=1&to=romel.tibay1234@gmail.com&su=Hey%20Romel!"
            aria-label="Email"
            class="grid h-11 w-11 place-items-center border-2 border-line bg-paper transition-all hover:border-accent hover:bg-accent hover:text-void hover:shadow-glow"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
              <path d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: profile scan + status readouts -->
      <div class="hero-card space-y-5 md:col-span-2">
        <!-- Profile scan panel (the one photo of Romel) -->
        <figure class="hud-corners group relative border-2 border-ink/30 bg-paper" data-scan>
          <figcaption
            class="hatch flex items-center justify-between border-b-2 border-line px-3 py-2"
          >
            <span
              class="hud-tab bg-chalk font-mono text-[0.65rem] font-bold uppercase tracking-[0.15em] text-void"
            >
              <span>Profile // Scan</span>
            </span>
            <span class="font-mono text-[0.6rem] uppercase tracking-wider text-muted">◎ ACQ</span>
          </figcaption>
          <div class="relative overflow-hidden">
            <img
              src="/profile.jpg"
              alt="Romel Andres Tibay"
              width="480"
              height="480"
              class="aspect-square w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0"
            />
            <!-- cyan duotone tint, clears on hover -->
            <div
              class="pointer-events-none absolute inset-0 bg-accent/25 mix-blend-color transition-opacity duration-500 group-hover:opacity-0"
            >
            </div>
            <!-- crosshair reticle -->
            <div class="pointer-events-none absolute inset-0">
              <span class="absolute left-3 top-3 h-4 w-4 border-l-2 border-t-2 border-accent/70"></span>
              <span class="absolute right-3 top-3 h-4 w-4 border-r-2 border-t-2 border-accent/70"></span>
              <span class="absolute bottom-3 left-3 h-4 w-4 border-b-2 border-l-2 border-accent/70"></span>
              <span class="absolute bottom-3 right-3 h-4 w-4 border-b-2 border-r-2 border-accent/70"></span>
            </div>
            <div class="scan-sweep"></div>
          </div>
          <div
            class="flex items-center justify-between gap-2 border-t-2 border-line px-4 py-2 font-mono text-[0.65rem] uppercase tracking-wider text-muted"
          >
            <span>ID: RTIBAY_R</span>
            <span class="flex items-center gap-1.5 text-signal">
              <span class="pulse inline-block h-1.5 w-1.5 rounded-full bg-signal"></span>
              Online
            </span>
          </div>
        </figure>

        <!-- Status card -->
        <div class="hud-corners border-2 border-line bg-paper" data-scan>
          <div class="hatch flex items-center border-b-2 border-line px-3 py-2">
            <span
              class="hud-tab bg-accent font-mono text-xs font-bold uppercase tracking-wide text-void"
            >
              <span class="flex items-center gap-1.5">
                <span class="pulse inline-block h-2 w-2 rounded-full bg-void"></span>
                Connection Secured
              </span>
            </span>
          </div>
          <dl class="divide-y-2 divide-line font-mono text-sm">
            <div class="flex justify-between gap-4 px-4 py-3">
              <dt class="text-muted">role</dt>
              <dd class="text-right font-semibold">Net Admin / Dev</dd>
            </div>
            <div class="flex justify-between gap-4 px-4 py-3">
              <dt class="text-muted">location</dt>
              <dd class="text-right font-semibold">Laguna, PH</dd>
            </div>
            <div class="flex justify-between gap-4 px-4 py-3">
              <dt class="text-muted">education</dt>
              <dd class="text-right font-semibold">BSIT · Mapúa MCL</dd>
            </div>
            <div class="flex justify-between gap-4 px-4 py-3">
              <dt class="text-muted">uptime</dt>
              <dd class="text-right font-semibold text-accent" data-count>99.9%</dd>
            </div>
            <div class="flex justify-between gap-4 px-4 py-3">
              <dt class="text-muted">open to</dt>
              <dd class="text-right font-semibold text-signal">Opportunities</dd>
            </div>
          </dl>
        </div>

        <!-- Fake system-readout strip -->
        <div class="hud-corners border-2 border-line bg-paper px-4 pb-4 pt-3" data-scan>
          <div class="mb-3 flex items-center">
            <span
              class="hud-tab hatch border-2 border-accent font-mono text-[0.6rem] font-bold uppercase tracking-[0.2em] text-accent"
            >
              <span>Sys // Monitor</span>
            </span>
          </div>
          <div class="space-y-3">
            {
              readouts.map((r) => (
                <div class="flex items-center gap-3 font-mono text-[0.7rem] uppercase tracking-wider">
                  <span class="w-8 shrink-0 text-muted">{r.k}</span>
                  <span class="ctos-bar hatch flex-1">
                    <span class="ctos-bar__fill" style={`width:${r.v}%`} data-fill={r.v} />
                  </span>
                  <span class="w-9 shrink-0 text-right text-accent" data-count>{r.v}%</span>
                </div>
              ))
            }
          </div>
          <div
            class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t-2 border-line pt-3 font-mono text-[0.65rem] uppercase tracking-wider text-muted"
          >
            <span>NODE <span class="text-accent">25.208.71.130</span></span>
            <span>0xA3F9::C2D1</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Full-bleed ctOS network data stream -->
  <DataStream />
</section>
