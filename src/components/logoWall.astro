---
const technologies = [
  "javaScript",
  "HTML5",
  "CSS3",
  "nodejs",
  "supabase",
  "mysql",
  "git",
  "bash",
];
---

<div class="marquee relative overflow-x-hidden border-t-2 border-line bg-paper py-4">
  <div class="flex w-max animate-scroll will-change-transform">
    {
      [...technologies, ...technologies, ...technologies, ...technologies].map(
        (tech, index) => (
          <div
            class="flex items-center gap-2.5 pr-10 md:pr-16"
            aria-hidden={index >= technologies.length ? "true" : "false"}
          >
            <img
              src={`/svg/${tech}.svg`}
              alt={tech}
              class="h-5 w-auto object-contain opacity-80 brightness-0 invert"
              width="24"
              height="24"
              loading={index < technologies.length ? "eager" : "lazy"}
              decoding="async"
            />
            <span class="font-mono text-sm uppercase tracking-wide text-ink/80">
              {tech}
            </span>
            <span class="pl-8 font-mono text-signal glow-s md:pl-14">/</span>
          </div>
        )
      )
    }
  </div>
</div>

<style>
  /* Pause the ticker on hover for readability */
  .marquee:hover .animate-scroll {
    animation-play-state: paused;
  }
</style>
