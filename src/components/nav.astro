---
interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Work", href: "#projects" },
  { label: "Timeline", href: "#timeline" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="sticky top-0 z-50 border-b-2 border-line bg-paper/95 backdrop-blur-sm"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-6 md:px-10"
  >
    <div class="flex items-center gap-4">
      <a
        href="#home"
        aria-label="Romel Andres Tibay — home"
        class="group flex items-center gap-2.5 font-mono text-sm font-bold uppercase tracking-tight"
      >
        <span
          class="grid h-8 w-8 shrink-0 place-items-center border-2 border-ink/70 text-ink transition-all group-hover:border-accent group-hover:bg-accent group-hover:text-void group-hover:shadow-glow"
        >R</span>
        <span class="hidden sm:inline">Romel Andres Tibay</span>
      </a>

      <span
        class="hidden items-center gap-2 border-l-2 border-line pl-4 font-mono text-xs uppercase tracking-wider text-muted lg:flex"
      >
        <span class="pulse inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <time id="ctos-clock" aria-hidden="true">--h --m --s</time>
      </span>
    </div>

    <nav class="hidden items-center gap-6 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link relative font-mono text-sm uppercase tracking-wide text-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/resume.pdf"
      download
      class="inline-flex items-center gap-1.5 border-2 border-chalk bg-chalk px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wide text-void shadow-glow-white transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:shadow-glow active:translate-y-0"
    >
      Resume
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
        <path
          d="M12 16L7 11L8.4 9.55L11 12.15V4H13V12.15L15.6 9.55L17 11L12 16ZM6 20C5.45 20 4.97917 19.8042 4.5875 19.4125C4.19583 19.0208 4 18.55 4 18V15H6V18H18V15H20V18C20 18.55 19.8042 19.0208 19.4125 19.4125C19.0208 19.8042 18.55 20 18 20H6Z"
        ></path>
      </svg>
    </a>
  </div>

  <!-- Mobile section links -->
  <nav
    class="flex overflow-x-auto border-t-2 border-line md:hidden [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link shrink-0 border-r-2 border-line px-4 py-2 font-mono text-xs uppercase tracking-wide text-muted"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .nav-link.active {
    color: var(--ink);
    font-weight: 700;
  }
  /* mobile active highlight */
  .nav-link.active {
    background: color-mix(in srgb, var(--signal) 12%, transparent);
  }

  /* desktop animated underline: cyan on hover, amber when active */
  @media (min-width: 768px) {
    .nav-link.active {
      background: transparent;
    }
    .nav-link::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -22px;
      height: 4px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .nav-link:hover::after {
      transform: scaleX(1);
    }
    .nav-link.active::after {
      transform: scaleX(1);
      background: var(--signal);
      box-shadow: 0 0 10px var(--signal);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(
      'header a.nav-link[href^="#"]'
    );

    const setActive = (id: string) => {
      navLinks.forEach((link) => {
        link.classList.toggle(
          "active",
          link.getAttribute("href") === `#${id}`
        );
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { threshold: 0.5, rootMargin: "-10% 0px -40% 0px" }
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>

<script>
  // Live ctOS clock readout (echoes the game's Time/Date HUD)
  const clock = document.getElementById("ctos-clock");
  if (clock) {
    const p = (n: number) => String(n).padStart(2, "0");
    const tick = () => {
      const d = new Date();
      clock.textContent = `${p(d.getHours())}h ${p(d.getMinutes())}m ${p(d.getSeconds())}s`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
