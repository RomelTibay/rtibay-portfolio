---
interface Project {
  title: string;
  tag: string;
  period: string;
  role: string;
  stack: string;
  description: string;
  link?: string;
}

const projects: Project[] = [
  {
    title: "saPIIre",
    tag: "Capstone",
    period: "2025 – 2026",
    role: "Lead Web Developer",
    stack: "Flutter & Supabase",
    description:
      "Cross-platform government intake system featuring a real-time QR autofill pipeline, a no-code form builder, role-based access control with custom auth, and a compliance analytics dashboard.",
  },
  {
    title: "Personify",
    tag: "TwitterCloneAPI",
    period: "Feb 2024",
    role: "Backend Developer",
    stack: "JavaScript, HTML & CSS",
    description:
      "Social media web app — a Twitter/X mockup built on a Node.js/Express REST API backend.",
  },
];
---

<section id="projects" class="border-b-2 border-line">
  <div class="mx-auto max-w-7xl px-6 md:px-10 py-16 md:py-24">
    <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p
          class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-muted"
        >
          <span class="inline-block h-2.5 w-2.5 bg-signal"></span>
          Selected Work
        </p>
        <h2
          class="font-sans text-4xl font-bold uppercase leading-none tracking-tight text-chalk md:text-6xl"
        >
          Projects
        </h2>
      </div>
      <p class="font-mono text-sm text-muted">
        [ {projects.length.toString().padStart(2, "0")} shipped ]
      </p>
    </div>

    <div data-stagger class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        projects.map((project, i) => (
          <article class="reveal hud-brackets group relative flex flex-col overflow-hidden border-2 border-line bg-paper p-6 transition-all duration-200 hover:-translate-x-1 hover:-translate-y-1 hover:border-accent hover:shadow-hard">
            <span class="pointer-events-none absolute -right-2 -top-4 select-none font-mono text-7xl font-bold text-ink/10 md:text-8xl">
              {String(i + 1).padStart(2, "0")}
            </span>

            <div class="relative flex flex-wrap items-center gap-3">
              <div class="w-full">
                <span
                  class="hud-tab hatch border border-line font-mono text-[0.6rem] uppercase tracking-[0.2em] text-accent"
                >
                  <span>&gt; FILE_{String(i + 1).padStart(3, "0")} // ACCESS GRANTED</span>
                </span>
              </div>
              <h3 class="font-sans text-2xl font-bold uppercase tracking-tight">
                {project.title}
              </h3>
              <span class="border-2 border-accent bg-accent px-2 py-0.5 font-mono text-xs font-bold uppercase text-void shadow-glow">
                {project.tag}
              </span>
            </div>

            <p class="relative mt-2 font-mono text-xs uppercase tracking-wide text-muted">
              {project.period} · {project.role} · {project.stack}
            </p>

            <p class="relative mt-4 flex-grow font-mono text-sm leading-relaxed text-ink/80">
              {project.description}
            </p>

            {project.link && (
              <a
                target="_blank"
                href={project.link}
                rel="noopener noreferrer"
                aria-label="GitHub repository"
                class="relative mt-5 inline-flex items-center gap-2 self-start border-2 border-line bg-paper px-4 py-2 font-mono text-xs font-bold uppercase tracking-wide transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:text-void hover:shadow-glow active:translate-y-0"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                  <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
                </svg>
                View on GitHub
              </a>
            )}
          </article>
        ))
      }
    </div>

    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://github.com/RomelTibay?tab=repositories"
      class="reveal mt-8 flex items-center justify-center gap-3 border-2 border-chalk bg-chalk px-6 py-4 font-mono text-sm font-bold uppercase tracking-wide text-void shadow-glow-white transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:shadow-glow active:translate-y-0"
    >
      More projects on GitHub
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
        <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path>
      </svg>
    </a>
  </div>
</section>
