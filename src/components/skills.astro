---
import SkillsList from "../React/SkillsList.tsx";
---

<section id="skills" class="border-b-2 border-line">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <div class="grid grid-cols-1 gap-10 py-16 md:grid-cols-5 md:py-24">
      <div class="reveal md:col-span-2">
        <p
          class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-muted"
        >
          <span class="inline-block h-2.5 w-2.5 bg-signal"></span>
          <span data-decode>Capabilities</span>
        </p>
        <h2
          class="font-sans text-4xl font-bold uppercase leading-none tracking-tight text-chalk md:text-6xl"
        >
          What<br />I do
        </h2>
        <p class="mt-6 max-w-sm font-mono text-sm leading-relaxed text-ink/70">
          Three tracks I keep sharp — from the network layer up to the
          interface. Tap a card to expand.
        </p>
      </div>

      <div class="reveal md:col-span-3">
        <SkillsList client:load />
      </div>
    </div>
  </div>
</section>
