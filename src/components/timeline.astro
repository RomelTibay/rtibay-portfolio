---
interface Entry {
  date: string;
  title: string;
  tag: string;
  role: string;
  detail: string;
  link?: { href: string; label: string };
}

const entries: Entry[] = [
  {
    date: "Apr – Jul 2026",
    title: "City Government of Biñan",
    tag: "Practicum",
    role: "Web Systems Developer · ICTO",
    detail:
      "Built the Biñan Access Card MIS bulk-data pipeline — Excel import/export, an async cron worker, and an import reviewer stress-tested to 50,000 records — plus a login/session guard and audit trail. CodeIgniter 4 & MySQL.",
    link: {
      href: "/practicum-narrative-report.pdf",
      label: "Practicum Narrative Report",
    },
  },
  {
    date: "2025 – 2026",
    title: "saPIIre",
    tag: "Capstone",
    role: "Lead Web Developer",
    detail:
      "Cross-platform government intake system — QR autofill, no-code form builder, RBAC auth, and a compliance analytics dashboard. Built with Flutter & Supabase.",
  },
  {
    date: "Mar 2024",
    title: "UniGrub",
    tag: "Project",
    role: "Frontend Developer",
    detail:
      "Website for college students presenting budget-conscious meal alternatives. C#, ASP.NET & CSS.",
  },
  {
    date: "Feb 2024",
    title: "Personify",
    tag: "Project",
    role: "Backend Developer",
    detail:
      "Twitter/X-style social app on an Express REST API with registration, authentication, posting, liking, and following. JavaScript, HTML & CSS.",
  },
  {
    date: "2022 – 2026",
    title: "Certifications & Training",
    tag: "Credentials",
    role: "CompTIA · Cisco · Google Cloud · CodeChum",
    detail:
      "CompTIA Tech+ (Dec 2025), CCNA: Introduction to Networks — Cisco (Sep 2025), Google Cloud Innovator / Developer Program (Mar 2026), CodeChum Python Course (Dec 2022).",
  },
  {
    date: "A.Y. 2025 – 2026",
    title: "BSIT, Cyber Security — Mapúa Malayan Colleges Laguna",
    tag: "Education",
    role: "Senior Year · Dean's List",
    detail:
      "Bachelor of Science in Information Technology, specializing in Cyber Security. Focused on network administration and web development.",
  },
];
---

<section id="timeline" class="border-b-2 border-line">
  <div class="mx-auto max-w-7xl px-6 md:px-10 py-16 md:py-24">
    <div class="reveal mb-12">
      <p
        class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-muted"
      >
        <span class="inline-block h-2.5 w-2.5 bg-signal"></span>
        <span data-decode>The Path</span>
      </p>
      <h2
        class="font-sans text-4xl font-bold uppercase leading-none tracking-tight text-chalk md:text-6xl"
        data-decode
      >
        Timeline
      </h2>
    </div>

    <ol data-stagger class="timeline-rail relative ml-2 border-l-2 border-line">
      {
        entries.map((entry) => (
          <li class="reveal relative mb-8 pl-8 last:mb-0 md:pl-12">
            <span
              class="absolute -left-[10px] top-1.5 h-4 w-4 border-2 border-accent bg-accent shadow-glow"
              aria-hidden="true"
            />
            <p class="mb-2 font-mono text-xs uppercase tracking-[0.15em] text-muted">
              &gt; {entry.date}
            </p>
            <div class="hud-brackets border-2 border-line bg-paper p-5 transition-all hover:-translate-y-0.5 hover:border-accent hover:shadow-hard-sm">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="font-sans text-xl font-bold uppercase tracking-tight">
                  {entry.title}
                </h3>
                <span class="border-2 border-accent bg-accent px-2 py-0.5 font-mono text-xs font-bold uppercase text-void">
                  {entry.tag}
                </span>
              </div>
              <p class="mt-1 font-mono text-xs uppercase tracking-wide text-accent">
                {entry.role}
              </p>
              <p class="mt-3 font-mono text-sm leading-relaxed text-ink/80">
                {entry.detail}
              </p>
              {entry.link && (
                <a
                  href={entry.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wide text-ink underline decoration-2 underline-offset-4 transition-colors hover:text-accent"
                >
                  {entry.link.label}
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path d="M10 6v2H5v11h11v-5h2v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6zm11-3v8h-2V6.414l-7.793 7.793-1.414-1.414L17.585 5H13V3h8z" />
                  </svg>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
