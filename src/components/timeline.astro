---
interface Entry {
  date: string;
  title: string;
  tag: string;
  role: string;
  detail: string;
}

const entries: Entry[] = [
  {
    date: "2025 – 2026",
    title: "saPIIre",
    tag: "Capstone",
    role: "Lead Web Developer",
    detail:
      "Cross-platform government intake system — QR autofill, no-code form builder, RBAC auth, and a compliance analytics dashboard. Built with Flutter & Supabase.",
  },
  {
    date: "Feb 2024",
    title: "Personify",
    tag: "Project",
    role: "Backend Developer",
    detail:
      "Twitter/X-style social app on a Node.js/Express REST API. JavaScript, HTML & CSS.",
  },
  {
    date: "Ongoing",
    title: "BSIT — Mapúa Malayan Colleges Laguna",
    tag: "Education",
    role: "Senior Year",
    detail:
      "Bachelor of Science in Information Technology. Focused on network administration and web development.",
  },
];
---

<section id="timeline" class="border-b-2 border-line">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24">
    <div class="reveal mb-12">
      <p
        class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-muted"
      >
        <span class="inline-block h-2.5 w-2.5 bg-signal"></span>
        The Path
      </p>
      <h2
        class="font-sans text-4xl font-bold uppercase leading-none tracking-tight md:text-6xl"
      >
        Timeline
      </h2>
    </div>

    <ol data-stagger class="timeline-rail relative ml-2 border-l-2 border-line">
      {
        entries.map((entry) => (
          <li class="reveal relative mb-8 pl-8 last:mb-0 md:pl-12">
            <span
              class="absolute -left-[10px] top-1.5 h-4 w-4 border-2 border-signal bg-signal shadow-glow-signal"
              aria-hidden="true"
            />
            <p class="mb-2 font-mono text-xs uppercase tracking-[0.15em] text-muted">
              {entry.date}
            </p>
            <div class="border-2 border-line bg-paper p-5 transition-all hover:-translate-y-0.5 hover:shadow-hard-sm">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="font-sans text-xl font-bold uppercase tracking-tight">
                  {entry.title}
                </h3>
                <span class="border-2 border-lime bg-lime px-2 py-0.5 font-mono text-xs font-bold uppercase text-void">
                  {entry.tag}
                </span>
              </div>
              <p class="mt-1 font-mono text-xs uppercase tracking-wide text-accent">
                {entry.role}
              </p>
              <p class="mt-3 font-mono text-sm leading-relaxed text-ink/80">
                {entry.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
