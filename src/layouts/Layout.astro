---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import GameBg from "@/components/gameBg.astro";
import SideRails from "@/components/sideRails.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Network Administrator & Developer</title>
    <meta
      name="description"
      content="Romel Andres S. Tibay - Aspiring Network Administrator & Software Developer. BSIT senior at Mapúa Malayan Colleges Laguna focused on network administration and web development."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://rtibay-portfolio.vercel.app/" />

    <meta name="theme-color" content="#05070a" />

    <!-- Enable progressive-enhancement hooks before paint (no FOUC) -->
    <script is:inline>
      document.documentElement.classList.add("js");
      // Gate the ctOS boot intro so it covers the page from first paint —
      // only once per tab and never under reduced motion. Failsafe clears it
      // even if the main script never runs.
      try {
        var seen = sessionStorage.getItem("ctos-boot");
        var rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!seen && !rm) {
          document.documentElement.classList.add("booting");
          setTimeout(function () {
            document.documentElement.classList.remove("booting");
          }, 2800);
        }
      } catch (e) {}
    </script>

    <meta
      property="og:title"
      content="Romel Andres S. Tibay | Network Administrator & Developer"
    />
    <meta
      property="og:description"
      content="Portfolio of Romel Andres S. Tibay, aspiring Network Administrator & Software Developer and BSIT senior at Mapúa MCL."
    />
    <meta
      property="og:image"
      content="https://rtibay-portfolio.vercel.app/og.image.png"
    />
    <meta property="og:url" content="https://rtibay-portfolio.vercel.app" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Romel Andres S. Tibay Portfolio" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Romel Andres S. Tibay",
        "alternateName": "Romel Tibay",
        "url": "https://rtibay-portfolio.vercel.app",
        "image": "https://rtibay-portfolio.vercel.app/og.image.png",
        "sameAs": ["https://github.com/RomelTibay"],
        "jobTitle": "Network Administrator & Software Developer",
        "description": "Aspiring Network Administrator & Software Developer, BSIT senior at Mapúa Malayan Colleges Laguna."
      }
    </script>
  </head>
  <body class="bg-void text-ink font-sans antialiased selection:bg-accent selection:text-void">
    <GameBg />
    <SideRails />
    <div class="scanlines" aria-hidden="true"></div>
    <div id="scroll-progress" aria-hidden="true"></div>
    <div id="cheat-toast" role="status" aria-live="polite">
      <span class="ct-key">◈ ROOT ACCESS</span> ctOS override unlocked
    </div>
    <div id="boot" class="boot-overlay" aria-hidden="true">
      <div class="boot-inner">
        <p id="boot-line" class="boot-line">ctOS // ESTABLISHING CONNECTION</p>
        <div class="boot-bar"><span></span></div>
        <div class="boot-scan"></div>
      </div>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Hex vars drive raw CSS below; the matching `-c` channel triplets let
       Tailwind's slash-opacity utilities (text-ink/80, border-ink/30…) work. */
    --void: #05070a; /* page background — pure near-black (cool) */
    --paper: #0a0f14; /* card / surface — blue-black panel */
    --line: #2a3742; /* structural borders — neutral steel grey (B&W) */
    --ink: #eef3f3; /* text — true near-white, only a whisper of cool */
    --muted: #7e8d93; /* neutral grey (muted text) */
    --chalk: #f6fafa; /* pure-white accent (stark B&W headings/frames) */
    --accent: #29e5e5; /* ctOS cyan — primary accent */
    --purple: #0bb6c8; /* deep teal (folded into the cyan family) */
    --signal: #ff9d2e; /* amber alert — sparse, "live"/warning accents */
    --lime: #29e5e5; /* cyan (folded; bg-lime → cyan highlight) */

    --void-c: 5 7 10;
    --paper-c: 10 15 20;
    --line-c: 42 55 66;
    --ink-c: 238 243 243;
    --muted-c: 126 141 147;
    --chalk-c: 246 250 250;
    --accent-c: 41 229 229;
    --signal-c: 255 157 46;
  }

  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  html {
    scroll-behavior: smooth;
    /* offset for the sticky top bar when anchor-jumping */
    scroll-padding-top: 5rem;
  }

  body {
    min-height: 100vh;
    background-color: var(--void);
    /* ambient ctOS cyan glow + faint scan grid + darkened edges */
    background-image:
      radial-gradient(
        60% 50% at 12% -5%,
        rgba(41, 229, 229, 0.1),
        transparent 60%
      ),
      radial-gradient(
        55% 45% at 100% 4%,
        rgba(41, 229, 229, 0.07),
        transparent 60%
      ),
      radial-gradient(
        70% 60% at 50% 120%,
        rgba(11, 182, 200, 0.08),
        transparent 60%
      ),
      radial-gradient(
        120% 120% at 50% 50%,
        transparent 55%,
        rgba(0, 0, 0, 0.55) 100%
      ),
      linear-gradient(
        90deg,
        rgba(41, 229, 229, 0.035) 0,
        rgba(41, 229, 229, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        0deg,
        rgba(41, 229, 229, 0.035) 0,
        rgba(41, 229, 229, 0.035) 1px,
        transparent 1px
      );
    background-size:
      auto,
      auto,
      auto,
      auto,
      44px 44px,
      44px 44px;
    background-attachment: fixed, fixed, fixed, fixed, scroll, scroll;
  }

  ::selection {
    background-color: var(--accent);
    color: var(--void);
  }

  /* Neon text-glow helpers */
  .glow-a {
    text-shadow: 0 0 16px var(--accent);
  }
  .glow-s {
    text-shadow: 0 0 16px var(--signal);
  }
  .glow-l {
    text-shadow: 0 0 16px var(--lime);
  }

  /* ctOS headline — stark near-white with a cyan data-glow */
  .neon-title {
    color: var(--ink);
    text-shadow:
      0 0 22px rgba(41, 229, 229, 0.35),
      0 0 2px rgba(41, 229, 229, 0.6);
  }

  /* Watch-Dogs glitch: periodic RGB-split flicker + positional jitter.
     Works with any line count (no text duplication), intensifies on hover. */
  .glitch {
    position: relative;
    will-change: transform, text-shadow;
  }
  @keyframes glitch-flicker {
    0%,
    88%,
    100% {
      text-shadow:
        0 0 22px rgba(41, 229, 229, 0.35),
        0 0 2px rgba(41, 229, 229, 0.6);
      transform: none;
      clip-path: none;
    }
    89% {
      text-shadow:
        -3px 0 0 var(--accent),
        3px 0 0 var(--signal),
        0 0 22px rgba(41, 229, 229, 0.5);
      transform: translateX(-2px);
    }
    91% {
      text-shadow:
        3px 0 0 var(--accent),
        -3px 0 0 var(--signal);
      transform: translateX(3px);
      clip-path: inset(12% 0 55% 0);
    }
    93% {
      text-shadow:
        -2px 0 0 var(--accent),
        2px 0 0 var(--signal);
      transform: translateX(-1px);
      clip-path: inset(60% 0 12% 0);
    }
    95% {
      text-shadow: 0 0 22px rgba(41, 229, 229, 0.4);
      transform: none;
      clip-path: none;
    }
  }
  html.js .glitch {
    animation: glitch-flicker 8s infinite;
  }
  html.js .glitch:hover {
    animation-duration: 1.4s;
  }

  /* HUD corner accents. `.hud-corners` also notches two corners (clip-path,
     which clips box-shadows — use it where no external shadow is needed).
     `.hud-brackets` adds only the L-shaped accents, so hard shadows survive. */
  .hud-corners,
  .hud-brackets {
    position: relative;
  }
  .hud-corners {
    clip-path: polygon(
      0 0,
      calc(100% - 14px) 0,
      100% 14px,
      100% 100%,
      14px 100%,
      0 calc(100% - 14px)
    );
  }
  .hud-corners::before,
  .hud-corners::after,
  .hud-brackets::before,
  .hud-brackets::after {
    content: "";
    position: absolute;
    width: 11px;
    height: 11px;
    border-color: var(--accent);
    pointer-events: none;
    z-index: 2;
  }
  .hud-corners::before,
  .hud-brackets::before {
    top: 6px;
    left: 6px;
    border-top: 2px solid;
    border-left: 2px solid;
  }
  .hud-corners::after,
  .hud-brackets::after {
    bottom: 6px;
    right: 6px;
    border-bottom: 2px solid;
    border-right: 2px solid;
  }

  /* CRT scanline overlay — sits above content, never blocks pointer events */
  .scanlines {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.4;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0) 0,
      rgba(0, 0, 0, 0) 2px,
      rgba(0, 0, 0, 0.11) 3px,
      rgba(0, 0, 0, 0) 4px
    );
  }

  /* Cyan line that sweeps down over a framed element (e.g. the profile photo) */
  .scan-sweep {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .scan-sweep::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 38%;
    top: -38%;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(41, 229, 229, 0.16),
      transparent
    );
    animation: scan-move 5s linear infinite;
  }
  @keyframes scan-move {
    0% {
      top: -38%;
    }
    100% {
      top: 100%;
    }
  }

  /* ---------- ctOS reference chrome (round 2) ---------- */

  /* Diagonal grey/white hatch texture (reference bar tracks & tab fills) */
  .hatch {
    background-image: repeating-linear-gradient(
      45deg,
      rgba(215, 247, 249, 0.09) 0,
      rgba(215, 247, 249, 0.09) 1px,
      transparent 1px,
      transparent 6px
    );
  }

  /* Skewed parallelogram label tab; inner text is counter-un-skewed */
  .hud-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transform: skewX(-12deg);
    padding: 0.28rem 0.9rem;
  }
  .hud-tab > * {
    transform: skewX(12deg);
  }

  /* Rotated-square diamond frame; inner content is counter-rotated */
  .hud-diamond {
    display: grid;
    place-items: center;
    transform: rotate(45deg);
    border: 2px solid color-mix(in srgb, var(--ink) 55%, transparent);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .hud-diamond:hover {
    border-color: var(--accent);
    box-shadow: 0 0 14px -3px var(--accent);
  }
  .hud-diamond > * {
    transform: rotate(-45deg);
  }

  /* ctOS progress bar — hatch track + cyan fill with a diamond end-cap */
  .ctos-bar {
    position: relative;
    height: 0.6rem;
    background-color: var(--void);
    border: 1px solid var(--line);
    overflow: visible;
  }
  .ctos-bar__fill {
    position: relative;
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 10px -2px var(--accent);
    transition: width 1.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ctos-bar__fill::after {
    content: "";
    position: absolute;
    right: -5px;
    top: 50%;
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: translateY(-50%) rotate(45deg);
    box-shadow: 0 0 8px var(--accent);
  }

  /* Radar sweep (rotating) for the ctOS emblem */
  @keyframes radar-sweep {
    to {
      transform: rotate(360deg);
    }
  }
  .radar-sweep {
    transform-box: view-box;
    transform-origin: center;
    animation: radar-sweep 11s linear infinite;
  }

  /* Equalizer bar flux for the network data-stream waveforms */
  @keyframes wave {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .wave-bar {
    transform-origin: center;
    animation: wave var(--wdur, 1.1s) ease-in-out infinite var(--wdelay, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-sweep,
    .wave-bar {
      animation: none !important;
    }
    .wave-bar {
      transform: scaleY(0.6);
    }
  }

  /* One-shot cyan scan line swept over a panel on reveal (JS-appended child,
     so it never collides with the ::before/::after corner brackets) */
  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 45%;
    pointer-events: none;
    z-index: 4;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(41, 229, 229, 0.18),
      transparent
    );
    animation: panel-scan 1.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes panel-scan {
    0% {
      transform: translateY(-130%);
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      transform: translateY(260%);
      opacity: 0;
    }
  }

  /* ctOS boot intro overlay (shown pre-paint only via html.booting) */
  .boot-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--void);
  }
  html.booting .boot-overlay {
    display: flex;
  }
  .boot-overlay.hide {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .boot-inner {
    width: min(90vw, 30rem);
    font-family: "JetBrains Mono Variable", monospace;
    text-align: center;
  }
  .boot-line {
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    text-shadow: 0 0 12px var(--accent);
  }
  .boot-bar {
    margin-top: 1rem;
    height: 3px;
    background: rgba(41, 229, 229, 0.15);
    overflow: hidden;
  }
  .boot-bar > span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: boot-fill 1.4s ease-out forwards;
  }
  @keyframes boot-fill {
    to {
      width: 100%;
    }
  }
  .boot-scan {
    margin-top: 0.9rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: boot-scanline 1.3s ease-in-out infinite;
  }
  @keyframes boot-scanline {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.85;
    }
  }

  /* Blocky, neon scrollbar */
  ::-webkit-scrollbar {
    width: 14px;
  }
  ::-webkit-scrollbar-track {
    background: var(--void);
    border-left: 2px solid var(--line);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--accent);
    border: 3px solid var(--void);
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--signal);
  }
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--accent) var(--void);
  }

  /* Chunky, visible focus for keyboard users */
  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---------- Motion ---------- */

  /* Scroll progress bar (top, neon) */
  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 100%;
    z-index: 60;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(
      90deg,
      var(--purple),
      var(--accent)
    );
    box-shadow: 0 0 12px var(--accent);
    will-change: transform;
  }

  /* Scroll-reveal — hidden only when JS is on, so no-JS shows everything */
  html.js .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: opacity, transform;
  }
  html.js .reveal.in {
    opacity: 1;
    transform: none;
  }

  /* Hero entrance — staggered rise on load */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  html.js .hero-anim > * {
    opacity: 0;
    animation: rise 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  html.js .hero-anim > *:nth-child(1) {
    animation-delay: 0.05s;
  }
  html.js .hero-anim > *:nth-child(2) {
    animation-delay: 0.15s;
  }
  html.js .hero-anim > *:nth-child(3) {
    animation-delay: 0.25s;
  }
  html.js .hero-anim > *:nth-child(4) {
    animation-delay: 0.35s;
  }
  html.js .hero-anim > *:nth-child(5) {
    animation-delay: 0.45s;
  }
  /* Name keeps the glitch flicker AND the entrance rise */
  html.js .hero-anim > .neon-title {
    animation:
      rise 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s forwards,
      glitch-flicker 8s 0.9s infinite;
  }
  html.js .hero-card {
    opacity: 0;
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s forwards;
  }

  /* Timeline: neon rail that draws down on reveal */
  .timeline-rail {
    position: relative;
  }
  .timeline-rail::after {
    content: "";
    position: absolute;
    left: -2px;
    top: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(
      var(--accent),
      var(--purple),
      transparent
    );
    box-shadow: 0 0 12px var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  html.js .timeline-rail.in::after {
    transform: scaleY(1);
  }

  /* Live pulse ring (status "online" dot) */
  @keyframes pulse-ring {
    0% {
      box-shadow: 0 0 0 0 rgba(41, 229, 229, 0.55);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(41, 229, 229, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(41, 229, 229, 0);
    }
  }
  .pulse {
    animation: pulse-ring 2.6s ease-out infinite;
  }

  /* Blinking terminal cursor */
  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  /* Konami easter-egg toast */
  #cheat-toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translate(-50%, 200%);
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 2px solid var(--accent);
    background: var(--paper);
    color: var(--ink);
    padding: 0.75rem 1.1rem;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 0 28px -4px var(--accent);
    transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.2, 1);
  }
  #cheat-toast.show {
    transform: translate(-50%, 0);
  }
  #cheat-toast .ct-key {
    font-weight: 700;
    color: var(--signal);
    text-shadow: 0 0 12px var(--signal);
  }

  /* ROOT ACCESS: crank the ctOS glow */
  html.godmode {
    --line: #1d5563;
    --line-c: 29 85 99;
  }
  html.godmode .neon-title {
    text-shadow:
      0 0 34px var(--accent),
      0 0 14px var(--accent),
      -2px 0 0 var(--signal);
  }
  html.godmode .shadow-glow,
  html.godmode .shadow-glow-signal {
    box-shadow: 0 0 34px -2px var(--accent);
  }
  html.godmode #scroll-progress {
    height: 5px;
    box-shadow: 0 0 20px var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
    /* Always show content; never leave it stuck hidden */
    html.js .reveal,
    html.js .hero-anim > *,
    html.js .hero-card {
      opacity: 1 !important;
      transform: none !important;
    }
    .timeline-rail::after {
      transform: scaleY(1) !important;
    }
    #scroll-progress {
      display: none;
    }
  }
</style>

<script>
  // Scroll-reveal (with optional stagger) + top progress bar.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // --- Scroll progress bar ---
  const bar = document.getElementById("scroll-progress");
  if (bar && !reduce) {
    let ticking = false;
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const p = max > 0 ? doc.scrollTop / max : 0;
      bar.style.transform = `scaleX(${p})`;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }

  // --- Scroll reveal ---
  const staggerContainers = Array.from(
    document.querySelectorAll<HTMLElement>("[data-stagger]")
  );
  const singles = Array.from(
    document.querySelectorAll<HTMLElement>(".reveal")
  ).filter((el) => !el.closest("[data-stagger]"));

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        if (el.hasAttribute("data-stagger")) {
          el.classList.add("in");
          const items = el.querySelectorAll<HTMLElement>(".reveal");
          items.forEach((it, i) =>
            setTimeout(() => it.classList.add("in"), i * 90)
          );
        } else {
          el.classList.add("in");
        }
        io.unobserve(el);
      }
    },
    { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
  );

  [...staggerContainers, ...singles].forEach((el) => io.observe(el));

  // --- ctOS effects: decrypt text, count-up, bar fill, panel scan ---
  const GLYPHS = "ABCDEF0123456789!<>-_\\/[]{}=+*#?";

  const finalOf = (el: HTMLElement) => {
    if (el.dataset.final === undefined) el.dataset.final = el.textContent ?? "";
    return el.dataset.final;
  };

  const decode = (el: HTMLElement) => {
    const text = finalOf(el).trim();
    if (reduce) {
      el.textContent = text;
      return;
    }
    const len = text.length;
    const total = Math.min(1600, Math.max(700, len * 55));
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / total);
      const shown = Math.floor(t * len);
      let out = "";
      for (let i = 0; i < len; i++) {
        const c = text[i];
        out +=
          i < shown || c === " "
            ? c
            : GLYPHS[(Math.random() * GLYPHS.length) | 0];
      }
      el.textContent = out;
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = text;
    };
    requestAnimationFrame(step);
  };

  const countUp = (el: HTMLElement) => {
    const text = finalOf(el);
    const m = text.match(/^(\D*)([\d.]+)([\s\S]*)$/);
    if (reduce || !m) {
      el.textContent = text;
      return;
    }
    const [, prefix, numStr, suffix] = m;
    const target = parseFloat(numStr);
    const decimals = numStr.includes(".") ? numStr.split(".")[1].length : 0;
    const total = 1500;
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / total);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = prefix + (target * eased).toFixed(decimals) + suffix;
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = text;
    };
    requestAnimationFrame(step);
  };

  const fill = (el: HTMLElement) => {
    const to = (el.dataset.fill || "0") + "%";
    if (reduce) {
      el.style.width = to;
      return;
    }
    requestAnimationFrame(() => {
      el.style.width = to;
    });
  };

  const scan = (el: HTMLElement) => {
    if (reduce) return;
    const line = document.createElement("div");
    line.className = "scan-line";
    line.addEventListener("animationend", () => line.remove(), { once: true });
    el.appendChild(line);
  };

  const fx = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        if (el.hasAttribute("data-decode")) decode(el);
        if (el.hasAttribute("data-count")) countUp(el);
        if (el.hasAttribute("data-fill")) fill(el);
        if (el.hasAttribute("data-scan")) scan(el);
        fx.unobserve(el);
      }
    },
    { threshold: 0.2, rootMargin: "0px 0px -8% 0px" }
  );
  // Zero the ctOS bars up-front (transition off, so no shrink flash) so JS
  // users see them fill on reveal; no-JS keeps the inline width (stays filled).
  if (!reduce) {
    document.querySelectorAll<HTMLElement>("[data-fill]").forEach((el) => {
      el.style.transition = "none";
      el.style.width = "0";
      void el.offsetWidth; // commit the 0 width without animating
      el.style.transition = "";
    });
  }
  document
    .querySelectorAll<HTMLElement>(
      "[data-decode],[data-count],[data-fill],[data-scan]"
    )
    .forEach((el) => fx.observe(el));

  // --- ctOS boot intro ---
  const boot = document.getElementById("boot");
  if (boot && document.documentElement.classList.contains("booting")) {
    try {
      sessionStorage.setItem("ctos-boot", "1");
    } catch (e) {}
    const line = document.getElementById("boot-line");
    if (line) decode(line as HTMLElement);
    window.setTimeout(() => {
      boot.classList.add("hide");
      window.setTimeout(() => {
        boot.remove();
        document.documentElement.classList.remove("booting");
      }, 650);
    }, 1500);
  } else if (boot) {
    boot.remove();
  }

  // --- Dev-console credits (game devs always open the console) ---
  console.log(
    "%cROMEL TIBAY%c // ctOS build v1.0  ◈\n%cconsole access detected. respect. run the konami sequence:  ↑ ↑ ↓ ↓ ← → ← → B A",
    "color:#29e5e5;font-weight:700;font-size:16px;text-shadow:0 0 8px #29e5e5",
    "color:#ff9d2e;font-size:13px",
    "color:#5f8a92;font-size:12px"
  );

  // --- Konami code: toggle GODMODE neon ---
  const KONAMI = [
    "ArrowUp",
    "ArrowUp",
    "ArrowDown",
    "ArrowDown",
    "ArrowLeft",
    "ArrowRight",
    "ArrowLeft",
    "ArrowRight",
    "b",
    "a",
  ];
  const toast = document.getElementById("cheat-toast");
  let ki = 0;
  let toastTimer: number | undefined;
  window.addEventListener("keydown", (e) => {
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    ki = key === KONAMI[ki] ? ki + 1 : key === KONAMI[0] ? 1 : 0;
    if (ki !== KONAMI.length) return;
    ki = 0;
    const on = document.documentElement.classList.toggle("godmode");
    if (!toast) return;
    toast.innerHTML = on
      ? '<span class="ct-key">◈ ROOT ACCESS</span> ctOS override unlocked'
      : '<span class="ct-key">ACCESS REVOKED</span> back to standard render';
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("show"), 3500);
  });
</script>
